+        ).filter(Q(close_requested_at__isnull=False) | Q(access__revoked_at__isnull=False) | Q(access__valid_until__lt=today) |
+                 Q(access__identity__user__is_active=False) | Q(access__identity__user__role='') |
+                 ~Q(access__identity__provider='orcid')).order_by('pk')
+        return JsonResponse({'session_ids': list(pending.values_list('omero_session_id', flat=True)[:100])})
+    if action == 'close_requested':
