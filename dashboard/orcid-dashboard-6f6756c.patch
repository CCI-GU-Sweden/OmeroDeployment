+class ExternalOmeroAccess(models.Model):
+    """A staff-reviewed identity link; it does not itself issue OMERO sessions."""
+
+    identity = models.OneToOneField('socialaccount.SocialAccount', on_delete=models.PROTECT, related_name='external_omero_access')
+    server = models.CharField(max_length=200)
+    omero_user_id = models.PositiveBigIntegerField()
+    omero_username = models.CharField(max_length=255)
+    valid_until = models.DateField()
+    verified_by = models.ForeignKey(User, on_delete=models.PROTECT, related_name='verified_external_omero_access')
+    verified_at = models.DateTimeField(auto_now=True)
+    revoked_at = models.DateTimeField(null=True, blank=True)
+
+    class Meta:
+        constraints = [
+            models.UniqueConstraint(fields=['server', 'omero_user_id'], name='unique_external_omero_identity'),
+            models.CheckConstraint(condition=models.Q(omero_user_id__gt=0), name='external_omero_positive_user_id'),
+        ]
+
+    def is_approved(self, today=None):
+        from django.conf import settings
+        from django.utils import timezone
+        today = today or timezone.localdate()
+        return (
+            self.identity.provider == 'orcid'
+            and settings.SOCIALACCOUNT_PROVIDERS['orcid']['BASE_DOMAIN'] == 'orcid.org'
+            and self.identity.user.is_active
+            and bool(self.identity.user.role)
+            and self.revoked_at is None
+            and self.valid_until >= today
+        )
+
+
+class ExternalOmeroSession(models.Model):
+    """Track OMERO session database IDs, never their bearer UUIDs."""
+
+    access = models.ForeignKey(ExternalOmeroAccess, on_delete=models.PROTECT, related_name='issued_sessions')
+    omero_session_id = models.PositiveBigIntegerField(unique=True)
+    expires_at = models.DateTimeField()
+    close_requested_at = models.DateTimeField(null=True, blank=True)
+    closed_at = models.DateTimeField(null=True, blank=True)
+    created_at = models.DateTimeField(auto_now_add=True)
+
+    class Meta:
+        constraints = [models.CheckConstraint(condition=models.Q(omero_session_id__gt=0), name='external_omero_positive_session_id')]
+
+
+class ExternalOmeroProvisioning(models.Model):
+    """A reviewed request to create one non-admin OMERO user."""
+
+    identity = models.OneToOneField('socialaccount.SocialAccount', on_delete=models.PROTECT, related_name='external_omero_provisioning')
+    requested_by = models.ForeignKey(User, on_delete=models.PROTECT, related_name='requested_omero_accounts')
+    server = models.CharField(max_length=200)
+    username = models.CharField(max_length=255)
+    first_name = models.CharField(max_length=150)
+    last_name = models.CharField(max_length=150)
+    group_id = models.PositiveBigIntegerField()
+    valid_until = models.DateField()
+    status = models.CharField(max_length=16, default='pending')
+    created_omero_user_id = models.PositiveBigIntegerField(null=True, blank=True)
+    created_at = models.DateTimeField(auto_now_add=True)
+    updated_at = models.DateTimeField(auto_now=True)
+
+    class Meta:
+        constraints = [
+            models.UniqueConstraint(fields=['server', 'username'], name='unique_external_provision_username'),
+            models.CheckConstraint(condition=models.Q(group_id__gt=0), name='external_provision_positive_group'),
+        ]
