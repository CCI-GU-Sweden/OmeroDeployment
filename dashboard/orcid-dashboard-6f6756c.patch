+++ b/accounts/test_external_omero_access.py
@@ -0,0 +1,169 @@
+from datetime import timedelta
+
+from allauth.socialaccount.models import SocialAccount
+from django.db import IntegrityError, transaction
+from django.test import TestCase, override_settings
+from django.utils import timezone
+from django.urls import reverse
+
+from .models import AuditEvent, ExternalOmeroAccess, ExternalOmeroProvisioning, ExternalOmeroSession, User
+
+
+@override_settings(SOCIALACCOUNT_PROVIDERS={'orcid': {'BASE_DOMAIN': 'orcid.org'}})
+class ExternalOmeroAccessTests(TestCase):
+    def setUp(self):
+        self.admin = User.objects.create_user('admin', role=User.Role.ADMIN)
+        self.user = User.objects.create_user('researcher', role=User.Role.RESEARCHER)
+        self.identity = SocialAccount.objects.create(user=self.user, provider='orcid', uid='0000-0002-1825-0097')
+        self.link = ExternalOmeroAccess.objects.create(
+            identity=self.identity, server='core-omero-test', omero_user_id=42,
+            omero_username='researcher', valid_until=timezone.localdate() + timedelta(days=1),
+            verified_by=self.admin,
+        )
+
+    def test_approval_fails_closed_for_revocation_expiry_or_disabled_account(self):
+        self.assertTrue(self.link.is_approved())
+        self.link.revoked_at = timezone.now()
+        self.assertFalse(self.link.is_approved())
+        self.link.revoked_at = None
+        self.link.valid_until = timezone.localdate() - timedelta(days=1)
+        self.assertFalse(self.link.is_approved())
+        self.link.valid_until = timezone.localdate()
+        self.user.is_active = False
+        self.assertFalse(self.link.is_approved())
+        self.user.is_active = True
+        self.user.role = ''
+        self.assertFalse(self.link.is_approved())
+
+    def test_sandbox_identity_is_not_approved(self):
+        self.identity.provider = 'orcid-sandbox'
+        self.assertFalse(self.link.is_approved())
+
+    @override_settings(SOCIALACCOUNT_PROVIDERS={'orcid': {'BASE_DOMAIN': 'sandbox.orcid.org'}})
+    def test_sandbox_environment_cannot_grant_production_identity_access(self):
+        self.assertFalse(self.link.is_approved())
+
+    def test_cannot_link_one_omero_user_to_two_identities(self):
+        other = User.objects.create_user('other', role=User.Role.RESEARCHER)
+        identity = SocialAccount.objects.create(user=other, provider='orcid', uid='0000-0003-1419-2405')
+        with self.assertRaises(IntegrityError), transaction.atomic():
+            ExternalOmeroAccess.objects.create(
+                identity=identity, server='core-omero-test', omero_user_id=42,
+                omero_username='researcher', valid_until=timezone.localdate(), verified_by=self.admin,
+            )
+
+    @override_settings(OMERO_APPROVAL_TOKEN='a' * 48, OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_service_approval_requires_tls_and_a_service_token(self):
+        url = reverse('omero_external_approval')
+        body = {'orcid': self.identity.uid}
+        token = {'HTTP_AUTHORIZATION': 'Bearer ' + 'a' * 48}
+        self.assertEqual(self.client.post(url, body, **token).status_code, 403)
+        self.assertEqual(self.client.post(url, body, secure=True).status_code, 403)
+        response = self.client.post(url, body, secure=True, **token)
+        self.assertEqual(response.json(), {'approved': True, 'access_id': self.link.pk, 'omero_user_id': 42, 'omero_username': 'researcher'})
+        self.assertIn('no-store', response['Cache-Control'])
+        self.link.revoked_at = timezone.now()
+        self.link.save(update_fields=['revoked_at'])
+        self.assertEqual(self.client.post(url, body, secure=True, **token).json(), {'approved': False})
+        self.assertEqual(self.client.post(url, {'orcid': 'invalid'}, secure=True, **token).status_code, 400)
+
+    @override_settings(OMERO_APPROVAL_TOKEN='a' * 48, OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_registered_sessions_are_queued_when_access_is_revoked(self):
+        url = reverse('omero_external_approval')
+        auth = {'HTTP_AUTHORIZATION': 'Bearer ' + 'a' * 48, 'secure': True}
+        body = {'action': 'register', 'access_id': self.link.pk, 'session_id': '987'}
+        self.assertEqual(self.client.post(url, body, **auth).json(), {'registered': True})
+        self.assertEqual(self.client.post(url, {'action': 'pending'}, **auth).json(), {'session_ids': []})
+        self.link.revoked_at = timezone.now()
+        self.link.save(update_fields=['revoked_at'])
+        self.assertEqual(self.client.post(url, {'action': 'pending'}, **auth).json(), {'session_ids': [987]})
+        self.assertEqual(self.client.post(url, {**body, 'session_id': '988'}, **auth).status_code, 403)
+        self.assertEqual(self.client.post(url, {'action': 'closed', 'session_id': '987'}, **auth).json(), {'closed': True})
+        self.assertIsNotNone(ExternalOmeroSession.objects.get(omero_session_id=987).closed_at)
+        self.assertEqual(self.client.post(url, {'action': 'pending'}, **auth).json(), {'session_ids': []})
+
+    @override_settings(OMERO_APPROVAL_TOKEN='a' * 48, OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_disabled_account_and_abandoned_login_queue_sessions(self):
+        url = reverse('omero_external_approval')
+        auth = {'HTTP_AUTHORIZATION': 'Bearer ' + 'a' * 48, 'secure': True}
+        self.client.post(url, {'action': 'register', 'access_id': self.link.pk, 'session_id': '987'}, **auth)
+        self.client.post(url, {'action': 'close_requested', 'session_id': '987'}, **auth)
+        self.assertEqual(self.client.post(url, {'action': 'pending'}, **auth).json(), {'session_ids': [987]})
+        ExternalOmeroSession.objects.filter(omero_session_id=987).update(close_requested_at=None)
+        self.user.is_active = False
+        self.user.save(update_fields=['is_active'])
+        self.assertEqual(self.client.post(url, {'action': 'pending'}, **auth).json(), {'session_ids': [987]})
+
+    @override_settings(OMERO_APPROVAL_TOKEN='', OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_service_is_disabled_without_token(self):
+        response = self.client.post(reverse('omero_external_approval'), {'orcid': self.identity.uid},
+                                    secure=True, HTTP_AUTHORIZATION='Bearer ')
+        self.assertEqual(response.status_code, 403)
+
+    @override_settings(OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_admin_can_record_and_revoke_verified_link(self):
+        self.link.delete()
+        url = reverse('update_external_omero_user')
+        body = {'identity_id': self.identity.pk, 'omero_user_id': '42', 'omero_username': 'researcher',
+                'valid_until': (timezone.localdate() + timedelta(days=365)).isoformat(),
+                'verified': 'yes', 'action': 'approve'}
+        self.client.force_login(self.user)
+        self.assertEqual(self.client.post(url, body).status_code, 403)
+        self.client.force_login(self.admin)
+        self.assertEqual(self.client.post(url, {**body, 'verified': ''}).status_code, 400)
+        self.assertEqual(self.client.post(url, body).status_code, 302)
+        link = ExternalOmeroAccess.objects.get(identity=self.identity)
+        self.assertTrue(link.is_approved())
+        self.assertTrue(AuditEvent.objects.filter(action='external_omero_link', target=self.user).exists())
+        self.assertContains(self.client.get(reverse('external_omero_users')), 'Create an OMERO account')
+        self.assertEqual(self.client.post(url, {'identity_id': self.identity.pk, 'action': 'revoke'}).status_code, 302)
+        link.refresh_from_db()
+        self.assertFalse(link.is_approved())
+
+    @override_settings(OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_csrf_required_for_link_management(self):
+        from django.test import Client
+        client = Client(enforce_csrf_checks=True)
+        client.force_login(self.admin)
+        self.assertEqual(client.post(reverse('update_external_omero_user'), {'identity_id': self.identity.pk, 'action': 'revoke'}).status_code, 403)
+
+    @override_settings(OMERO_APPROVAL_TOKEN='a' * 48, OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_admin_requests_account_worker_records_creation_and_link(self):
+        self.link.delete()
+        body = {'identity_id': self.identity.pk, 'group_id': '103', 'first_name': 'Test', 'last_name': 'Researcher',
+                'valid_until': (timezone.localdate() + timedelta(days=30)).isoformat(), 'verified': 'yes'}
+        url = reverse('create_external_omero_user')
+        self.client.force_login(self.user)
+        self.assertEqual(self.client.post(url, body).status_code, 403)
+        self.client.force_login(self.admin)
+        self.assertEqual(self.client.post(url, {**body, 'verified': ''}).status_code, 400)
+        self.assertEqual(self.client.post(url, body).status_code, 302)
+        job = ExternalOmeroProvisioning.objects.get(identity=self.identity)
+        self.assertEqual(job.status, 'pending')
+        self.assertFalse(ExternalOmeroAccess.objects.filter(identity=self.identity).exists())
+        auth = {'HTTP_AUTHORIZATION': 'Bearer ' + 'a' * 48, 'secure': True}
+        endpoint = reverse('omero_external_approval')
+        claim = self.client.post(endpoint, {'action': 'provision_claim'}, **auth).json()['job']
+        self.assertEqual(claim['username'], 'orcid-' + self.identity.uid)
+        self.assertEqual(claim['group_id'], 103)
+        self.assertEqual(self.client.post(endpoint, {'action': 'provision_claim'}, **auth).json(), {'job': None})
+        response = self.client.post(endpoint, {'action': 'provision_complete', 'job_id': job.pk, 'omero_user_id': 555}, **auth)
+        self.assertEqual(response.json(), {'recorded': True})
+        self.assertEqual(ExternalOmeroAccess.objects.get(identity=self.identity).omero_user_id, 555)
+        self.assertTrue(AuditEvent.objects.filter(action='external_omero_created', target=self.user).exists())
+
+    @override_settings(OMERO_APPROVAL_TOKEN='a' * 48, OMERO_APPROVAL_SERVER='core-omero-test')
+    def test_failed_provision_does_not_create_a_link_or_retry(self):
+        self.link.delete()
+        self.client.force_login(self.admin)
+        self.client.post(reverse('create_external_omero_user'), {'identity_id': self.identity.pk, 'group_id': '103',
+            'first_name': 'Test', 'last_name': 'Researcher', 'valid_until': timezone.localdate().isoformat(), 'verified': 'yes'})
+        job = ExternalOmeroProvisioning.objects.get(identity=self.identity)
+        auth = {'HTTP_AUTHORIZATION': 'Bearer ' + 'a' * 48, 'secure': True}
+        endpoint = reverse('omero_external_approval')
+        self.client.post(endpoint, {'action': 'provision_claim'}, **auth)
+        self.client.post(endpoint, {'action': 'provision_failed', 'job_id': job.pk, 'omero_user_id': 555}, **auth)
+        job.refresh_from_db()
+        self.assertEqual((job.status, job.created_omero_user_id), ('failed', 555))
+        self.assertFalse(ExternalOmeroAccess.objects.filter(identity=self.identity).exists())
+        self.assertIsNone(self.client.post(endpoint, {'action': 'provision_claim'}, **auth).json()['job'])
