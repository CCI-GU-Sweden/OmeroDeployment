+{% extends 'base.html' %}{% load static %}{% block content %}
+<section class="dashboard-content administration-view">
+  <div class="administration-header"><div><p class="eyebrow">Access management</p><h1 class="title is-3">External OMERO users</h1></div><a class="button is-light" href="{% url 'administration' %}">← Administration</a></div>
+  <div class="admin-panel">
+    <p>Review the researcher in person and independently confirm their OMERO account before linking it. The link expires on the review date.</p>
+    <p>Save a link to grant ORCID access to the existing OMERO account. Revoking the link blocks new sign-ins and queues its ORCID-issued web and upload sessions for termination. Closure is retried if OMERO is unavailable.</p>
+    <p>For a new researcher, request an account below. Choose an existing approved OMERO group; requests that need reconciliation remain visible for staff review.</p>
+    {% if not server %}<p>External OMERO access is not configured.</p>{% else %}
+    <form method="post" action="{% url 'update_external_omero_user' %}">{% csrf_token %}
+      <label>Authenticated ORCID user <span class="select"><select name="identity_id" required><option value="">Select a user</option>{% for account in accounts %}{% for identity in account.socialaccount_set.all %}{% if identity.provider == 'orcid' %}<option value="{{ identity.pk }}">{{ account.username }} — {{ identity.uid }}</option>{% endif %}{% endfor %}{% endfor %}</select></span></label>
+      <label>OMERO user ID <input class="input" name="omero_user_id" type="number" min="1" required></label>
+      <label>OMERO username <input class="input" name="omero_username" maxlength="255" required></label>
+      <label>Review by <input class="input" name="valid_until" type="date" required></label>
+      <label><input type="checkbox" name="verified" value="yes" required> I met the researcher and verified this OMERO account.</label>
+      <button class="button is-link" name="action" value="approve">Save link</button>
+    </form>{% endif %}
+  </div>
+  {% if server %}<div class="admin-panel"><h2 class="title is-5">Create an OMERO account</h2>
+    <form method="post" action="{% url 'create_external_omero_user' %}">{% csrf_token %}
+      <label>Authenticated ORCID user <span class="select"><select name="identity_id" required><option value="">Select a user</option>{% for account in accounts %}{% for identity in account.socialaccount_set.all %}{% if identity.provider == 'orcid' %}<option value="{{ identity.pk }}">{{ account.username }} — {{ identity.uid }}</option>{% endif %}{% endfor %}{% endfor %}</select></span></label>
+      <label>First name <input class="input" name="first_name" maxlength="150" required></label>
+      <label>Last name <input class="input" name="last_name" maxlength="150" required></label>
+      <label>Approved existing OMERO group <span class="select"><select id="provision-group" name="group_id" required disabled><option value="">Loading groups…</option></select></span></label><p id="provision-group-status" role="status"></p>
+      <label>Review by <input class="input" name="valid_until" type="date" required></label>
+      <label><input type="checkbox" name="verified" value="yes" required> I met the researcher and verified their access to this group.</label>
+      <button class="button is-link" id="provision-submit" type="submit" disabled>Request account</button>
+    </form>
+    <p>The account name is based on the authenticated ORCID iD. No password is created.</p>
+    <table><thead><tr><th>ORCID</th><th>Group ID</th><th>Request status</th><th>OMERO user ID</th></tr></thead><tbody>
+    {% for job in provisioning %}<tr><td>{{ job.identity.uid }}</td><td>{{ job.group_id }}</td><td>{{ job.status }}</td><td>{{ job.created_omero_user_id|default:'—' }}</td></tr>{% empty %}<tr><td colspan="4">No account requests.</td></tr>{% endfor %}
+    </tbody></table><p>Failed or interrupted requests require administrator reconciliation; they are not automatically repeated.</p>
+  </div>{% endif %}
+  <div class="admin-panel"><h2 class="title is-5">Existing links</h2><div class="admin-table-wrap"><table><thead><tr><th>ORCID</th><th>OMERO account</th><th>Review by</th><th>Verified by</th><th>Status</th><th>Action</th></tr></thead><tbody>
+    {% for link in links %}<tr><td>{{ link.identity.uid }}</td><td>{{ link.omero_username }} ({{ link.omero_user_id }})</td><td>{{ link.valid_until }}</td><td>{{ link.verified_by.username }}</td><td>{% if link.revoked_at %}Revoked{% elif link.is_approved %}Approved{% else %}Expired or inactive{% endif %}</td><td>{% if not link.revoked_at %}<form method="post" action="{% url 'update_external_omero_user' %}">{% csrf_token %}<input type="hidden" name="identity_id" value="{{ link.identity_id }}"><button class="button is-small" name="action" value="revoke">Revoke link</button></form>{% endif %}</td></tr>{% empty %}<tr><td colspan="6">No links recorded.</td></tr>{% endfor %}
+  </tbody></table></div></div>
+</section><script src="{% static 'js/external_omero_users.js' %}" defer></script>{% endblock %}
diff --git a/static/js/external_omero_users.js b/static/js/external_omero_users.js
