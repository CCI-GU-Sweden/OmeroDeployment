+        response = JsonResponse({'approved': False})
+    else:
+        response = JsonResponse({'approved': True, 'access_id': link.pk, 'omero_user_id': link.omero_user_id,
+                                 'omero_username': link.omero_username})
+    response['Cache-Control'] = 'no-store'
+    return response
+
