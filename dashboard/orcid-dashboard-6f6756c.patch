+++ b/static/js/external_omero_users.js
@@ -0,0 +1,21 @@
+(() => {
+  const select = document.getElementById('provision-group');
+  const button = document.getElementById('provision-submit');
+  const status = document.getElementById('provision-group-status');
+  if (!select || !button || !status) return;
+  fetch('/api/omero/groups', {credentials: 'same-origin'}).then(response => {
+    if (!response.ok) throw new Error('Group inventory unavailable');
+    return response.json();
+  }).then(data => {
+    select.replaceChildren(new Option('Select a group', ''));
+    for (const group of data.groups) {
+      if (['system', 'user'].includes((group.name || '').toLowerCase())) continue;
+      select.add(new Option(`${group.name || 'Group'} (ID ${group.id})`, String(group.id)));
+    }
+    select.disabled = select.options.length === 1;
+    if (select.disabled) status.textContent = 'No groups are available. Try again later.';
+    const update = () => { button.disabled = select.disabled || !select.value; };
+    select.addEventListener('change', update);
+    update();
+  }).catch(() => { status.textContent = 'Could not load OMERO groups. Try again later.'; });
+})();
