+        return JsonResponse({'requested': True})
+    if action == 'closed':
+        from django.utils import timezone
+        session_id = request.POST.get('session_id', '')
+        if not session_id.isdecimal() or not 1 <= int(session_id) <= 9223372036854775807:
+            return HttpResponseBadRequest('Invalid session.')
+        ExternalOmeroSession.objects.filter(access__server=settings.OMERO_APPROVAL_SERVER,
+                                           omero_session_id=int(session_id), closed_at__isnull=True).update(closed_at=timezone.now())
+        return JsonResponse({'closed': True})
+    if action != 'lookup':
+        return HttpResponseBadRequest('Invalid action.')
+    orcid = request.POST.get('orcid', '')
