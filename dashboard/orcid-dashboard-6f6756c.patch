+                    job.valid_until < timezone.localdate() or settings.SOCIALACCOUNT_PROVIDERS['orcid']['BASE_DOMAIN'] != 'orcid.org'):
+                job.status = 'failed'
+                job.save(update_fields=['status', 'updated_at'])
+                return JsonResponse({'job': None})
+            job.status = 'processing'
+            job.save(update_fields=['status', 'updated_at'])
+            return JsonResponse({'job': {'id': job.pk, 'username': job.username, 'first_name': job.first_name,
+                                          'last_name': job.last_name, 'group_id': job.group_id}})
+    if action in ('provision_complete', 'provision_failed'):
+        job_id = request.POST.get('job_id', '')
+        user_id = request.POST.get('omero_user_id', '')
+        if not job_id.isdecimal() or not 1 <= int(job_id) <= 9223372036854775807:
+            return HttpResponseBadRequest('Invalid provisioning request.')
+        if user_id and (not user_id.isdecimal() or not 1 <= int(user_id) <= 9223372036854775807):
+            return HttpResponseBadRequest('Invalid OMERO user.')
+        with transaction.atomic():
+            job = ExternalOmeroProvisioning.objects.select_for_update().select_related('identity__user', 'requested_by').filter(
+                pk=int(job_id), server=settings.OMERO_APPROVAL_SERVER).first()
+            if not job or job.status != 'processing':
+                return HttpResponseForbidden('Access denied.')
+            if action == 'provision_failed':
+                job.status = 'failed'
+                job.created_omero_user_id = int(user_id) if user_id else None
+                job.save(update_fields=['status', 'created_omero_user_id', 'updated_at'])
+                return JsonResponse({'recorded': True})
+            if not user_id or not is_dashboard_admin(job.requested_by) or not job.identity.user.is_active or not job.identity.user.role:
+                return HttpResponseForbidden('Access denied.')
+            from django.utils import timezone
+            if job.valid_until < timezone.localdate() or ExternalOmeroAccess.objects.filter(identity=job.identity).exists():
+                return HttpResponseForbidden('Access denied.')
+            link = ExternalOmeroAccess.objects.create(identity=job.identity, server=job.server, omero_user_id=int(user_id),
+                omero_username=job.username, valid_until=job.valid_until, verified_by=job.requested_by)
+            job.status, job.created_omero_user_id = 'complete', int(user_id)
+            job.save(update_fields=['status', 'created_omero_user_id', 'updated_at'])
+            AuditEvent.objects.create(actor=job.requested_by, target=job.identity.user, action='external_omero_created',
+                before={}, after={'omero_user_id': link.omero_user_id, 'group_id': job.group_id, 'server': job.server})
+            return JsonResponse({'recorded': True})
+    if action == 'register':
+        from datetime import timedelta
+        from django.utils import timezone
+        access_id = request.POST.get('access_id', '')
+        session_id = request.POST.get('session_id', '')
+        if (not access_id.isdecimal() or not session_id.isdecimal() or
+                not 1 <= int(access_id) <= 9223372036854775807 or
+                not 1 <= int(session_id) <= 9223372036854775807):
+            return HttpResponseBadRequest('Invalid session.')
+        with transaction.atomic():
+            link = ExternalOmeroAccess.objects.select_for_update().select_related('identity__user').filter(
+                pk=int(access_id), server=settings.OMERO_APPROVAL_SERVER).first()
+            if not link or not link.is_approved():
+                return HttpResponseForbidden('Access denied.')
+            # The OMERO caller sets the corresponding maximum session lifetime.
+            existing, created = ExternalOmeroSession.objects.get_or_create(
